{
  "name": "morphee-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Morphee AI — Real-Time 4D Facial Expression System (Phase 1-3 prototype)",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "concurrently \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "package": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.morphee.ai",
    "productName": "Morphee AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@pixiv/three-vrm": "^3.5.2",
    "three": "^0.166.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.10",
    "wait-on": "^9.1.0"
  }
}
